<Window x:Class="Caption.Views.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caption · Transcript"
        Width="720" Height="620" MinWidth="460" MinHeight="320"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="True" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Image Source="/Assets/Caption.png" Width="18" Height="18" />
            <TextBlock Text="Transcript" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" Margin="10,0,0,0" Foreground="{DynamicResource SubtextBrush}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="16,4,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Padding="30,6,8,6" TextChanged="SearchBox_TextChanged" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" Margin="11,0,0,0"
                           Foreground="{DynamicResource SubtextBrush}" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search the transcript" Margin="31,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Style="{StaticResource SoftButton}" Click="Copy_Click" ToolTip="Copy the selected lines, or everything (Ctrl+C)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="12" />
                        <TextBlock Text="Copy" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SoftButton}" Click="Save_Click" Margin="6,0,0,0" ToolTip="Save as .txt or .srt (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="12" />
                        <TextBlock Text="Save" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="Clear_Click" Margin="6,0,0,0" ToolTip="Clear the transcript" />
            </StackPanel>
        </Grid>

        <!-- Lines -->
        <ListBox x:Name="List" Grid.Row="2" Margin="8,0,8,0" BorderThickness="0" Background="Transparent"
                 SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" CornerRadius="8" Padding="10,7" Margin="0,1" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource FaintBrush}" FontSize="12" Margin="0,2,0,0"
                                   FontFamily="Cascadia Mono, Consolas" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="14" />
                            <TextBlock Text="{Binding Secondary}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SubtextBrush}"
                                       Visibility="{Binding Secondary, Converter={StaticResource NullVis}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Lines show up here as people talk." HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />

        <!-- The line being spoken right now -->
        <Border Grid.Row="3" Margin="16,6,16,14" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                x:Name="PartialBox" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                <TextBlock x:Name="PartialText" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource SubtextBrush}" FontStyle="Italic" />
            </Grid>
        </Border>
    </Grid>
</Window>
