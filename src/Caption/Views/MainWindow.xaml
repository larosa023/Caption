<Window x:Class="Caption.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Caption.Controls"
        Title="Caption"
        Width="1000" Height="700" MinWidth="820" MinHeight="560"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="True" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,14,0,18" Height="30">
                    <Image Source="/Assets/Caption.png" Width="22" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="Caption" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,8,18,16">
                    <Button Style="{StaticResource BaseButton}" HorizontalContentAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="general"
                            Visibility="{Binding UpdateBadge, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Update ready" Margin="8,0,0,0" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource FaintBrush}" FontSize="11.5" />
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="home"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=home}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" FontSize="15" Width="20" /><TextBlock Text="Home" Margin="12,0,0,0" /></StackPanel>
                    </RadioButton>
                    <TextBlock Text="SETTINGS" Foreground="{DynamicResource FaintBrush}" FontSize="11" FontWeight="SemiBold" Margin="22,18,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="profiles"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=profiles}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="15" Width="20" /><TextBlock Text="Audio &amp; profiles" Margin="12,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="bar"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=bar}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xED1E;" FontSize="15" Width="20" /><TextBlock Text="Caption bar" Margin="12,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="model"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=model}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE950;" FontSize="15" Width="20" /><TextBlock Text="Speech model" Margin="12,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="translation"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=translation}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xF2B7;" FontSize="15" Width="20" /><TextBlock Text="Translation" Margin="12,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="appearance"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=appearance}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE790;" FontSize="15" Width="20" /><TextBlock Text="Appearance" Margin="12,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="hotkeys"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=hotkeys}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" FontSize="15" Width="20" /><TextBlock Text="Hotkeys" Margin="12,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="general"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=general}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15" Width="20" /><TextBlock Text="General" Margin="12,0,0,0" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Margin="0,44,0,0">
                <Grid Margin="32,4,32,32" MaxWidth="860" HorizontalAlignment="Stretch">

                    <!-- ===================== HOME ===================== -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=home}">

                        <!-- First run -->
                        <Border Style="{StaticResource Card}" Padding="24,20" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Welcome to Caption" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                                <TextBlock Style="{StaticResource Sub}" FontSize="13" Margin="0,6,0,0"
                                           Text="Live captions for anything playing on your PC. Speech is recognized on your own computer: nothing is sent to the internet. Pick a model to download once." />
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,8" Margin="0,14,0,10" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F8;" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding GpuSummary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SetupModel}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1.5" Padding="14,11" Margin="0,4"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" Background="{DynamicResource Surface2Brush}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrongBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="Downloaded" FontSize="11" Foreground="{DynamicResource GoodBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Blurb}" Style="{StaticResource Sub}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding SpeedLabel}" Style="{StaticResource Sub}" Margin="0,3,0,0" Foreground="{DynamicResource FaintBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" MinWidth="150">
                                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SubtextBrush}" Margin="0,4,0,0">
                                                        <Run Text="Speed " /><Run Text="{Binding Speed, Mode=OneWay, Converter={StaticResource Dots}}" Foreground="{DynamicResource AccentBrush}" />
                                                    </TextBlock>
                                                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SubtextBrush}">
                                                        <Run Text="Accuracy " /><Run Text="{Binding Accuracy, Mode=OneWay, Converter={StaticResource Dots}}" Foreground="{DynamicResource AccentBrush}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{Binding EngineDownloadText}" Style="{StaticResource Sub}" Margin="2,10,0,0" />
                                <ProgressBar Value="{Binding SetupProgress, Mode=OneWay}" Maximum="1" Margin="0,14,0,0"
                                             Visibility="{Binding SetupBusy, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding SetupStatus}" Style="{StaticResource Sub}" Margin="2,8,0,0"
                                           Visibility="{Binding SetupStatus, Converter={StaticResource NullVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Download and start" Command="{Binding SetupDownloadCommand}" Padding="22,10" />
                                    <Button Style="{StaticResource SoftButton}" Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelDownloadCommand}"
                                            Visibility="{Binding SetupBusy, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Status -->
                        <Border Style="{StaticResource Card}" Padding="24,20" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xED1E;" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateTitle}" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                                        <TextBlock Text="{Binding Controller.Status}" Style="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Controller.SourceStatus}" Style="{StaticResource Sub}" Margin="0,2,0,0"
                                                   Visibility="{Binding Controller.SourceStatus, Converter={StaticResource NullVis}}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0" Foreground="{DynamicResource FaintBrush}">
                                            <Run Text="{Binding Controller.EngineText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Controller.Stats, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SoftButton}" Content="{Binding PauseText}" Command="{Binding PauseCommand}" Margin="0,0,8,0"
                                                Visibility="{Binding Controller.IsOn, Converter={StaticResource BoolVis}}" />
                                        <Button Style="{StaticResource AccentButton}" Content="{Binding ToggleText}" Command="{Binding ToggleCaptionsCommand}" Padding="20,10" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Value="{Binding Controller.Progress, Mode=OneWay}" Maximum="1" Margin="68,14,0,0"
                                             Visibility="{Binding Controller.IsBusy, Converter={StaticResource BoolVis}}" />

                                <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource SubtextBrush}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" HorizontalAlignment="Left" MinWidth="240">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource SubtextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource SoftButton}" Command="{Binding ShowTranscriptCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="12" />
                                                <TextBlock Text="Transcript" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SoftButton}" Command="{Binding MoveBarCommand}" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C2;" FontSize="12" />
                                                <TextBlock Text="Move caption bar" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,0" Foreground="{DynamicResource FaintBrush}">
                                    <Run Text="Tip: " /><Run Text="{Binding ToggleHotkeyText, Mode=OneWay}" /><Run Text=" turns captions on and off from anywhere." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Update ready -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,12" Visibility="{Binding Updater.UpdateReady, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="Update ready" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Sub}"><Run Text="Version " /><Run Text="{Binding Updater.AvailableVersion, Mode=OneWay}" /><Run Text=" is downloaded and verified." /></TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Restart to update" Command="{Binding RestartToUpdateCommand}" />
                            </Grid>
                        </Border>

                        <!-- Live preview -->
                        <TextBlock Text="Latest" Style="{StaticResource SectionLabel}" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                        <Border Style="{StaticResource Card}" Padding="18,12" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding RecentLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource FaintBrush}" FontSize="12" FontFamily="Cascadia Mono, Consolas" Margin="0,1,0,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Secondary}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubtextBrush}"
                                                               Visibility="{Binding Secondary, Converter={StaticResource NullVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Controller.Partial}" TextWrapping="Wrap" FontStyle="Italic" Foreground="{DynamicResource SubtextBrush}"
                                           Margin="70,3,0,0" Visibility="{Binding Controller.Partial, Converter={StaticResource NullVis}}" />
                                <TextBlock Text="Nothing yet. Start captions and play something with speech." Style="{StaticResource Sub}"
                                           Visibility="{Binding RecentLines.Count, Converter={StaticResource EqVis}, ConverterParameter=0}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== PROFILES ===================== -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=profiles}">
                        <TextBlock Text="Audio &amp; profiles" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Sub}" FontSize="13" Margin="0,-8,0,8"
                                   Text="A profile is what Caption listens to and how it translates, like &quot;Streams&quot; or &quot;Calls&quot;. Switch profiles from Home or the tray menu." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- list -->
                            <StackPanel>
                                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" CornerRadius="9" Padding="12,9" Margin="0,2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="5,0" Margin="8,0,0,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="In use" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{DynamicResource SubtextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource SoftButton}" Command="{Binding AddProfileCommand}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="11" /><TextBlock Text="New" Margin="6,0,0,0" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplicate" Command="{Binding DuplicateProfileCommand}" Margin="6,0,0,0" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" Command="{Binding DeleteProfileCommand}" Margin="2,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- editor -->
                            <StackPanel Grid.Column="2" DataContext="{Binding SelectedProfile}" Visibility="{Binding Converter={StaticResource NullVis}}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <TextBlock Text="Name" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" />
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="This profile" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Captions use the profile marked In use" />
                                            </StackPanel>
                                            <Button Style="{StaticResource SoftButton}" Content="Use this profile" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.UseProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                                            <TextBlock Text="In use" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Listen to" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Padding="16,12">
                                    <StackPanel>
                                        <Border Style="{StaticResource SegPanel}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SegButton}" Content="Everything" Command="{Binding DataContext.SetSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="system"
                                                        Tag="{Binding Source, Converter={StaticResource Eq}, ConverterParameter=system}" />
                                                <Button Style="{StaticResource SegButton}" Content="One output" Command="{Binding DataContext.SetSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="device"
                                                        Tag="{Binding Source, Converter={StaticResource Eq}, ConverterParameter=device}" />
                                                <Button Style="{StaticResource SegButton}" Content="Only some apps" Command="{Binding DataContext.SetSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="apps"
                                                        Tag="{Binding Source, Converter={StaticResource Eq}, ConverterParameter=apps}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource Sub}" Margin="2,8,0,0" Visibility="{Binding Source, Converter={StaticResource EqVis}, ConverterParameter=system}"
                                                   Text="Everything your default speakers or headphones play. Follows Windows when the default changes." />

                                        <Grid Margin="0,10,0,0" Visibility="{Binding Source, Converter={StaticResource EqVis}, ConverterParameter=device}">
                                            <TextBlock Text="Output" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Device}" DisplayMemberPath="Name" Width="300" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.RefreshDevicesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding Source, Converter={StaticResource EqVis}, ConverterParameter=apps}">
                                            <TextBlock Style="{StaticResource Sub}" Text="Only these apps are heard (including their helper processes), even if they play on another device. Apps that aren't open yet are picked up when they start." />
                                            <ItemsControl ItemsSource="{Binding Apps}" Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="14" Padding="12,4,4,4" Margin="0,0,6,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="9" Content="&#xE711;" Margin="6,0,0,0"
                                                                        Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="AppPicker" ItemsSource="{Binding DataContext.RunningApps, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" />
                                                                <TextBlock Text="{Binding Exe}" Margin="8,0,0,0" Foreground="{DynamicResource FaintBrush}" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="  playing now" Foreground="{DynamicResource GoodBrush}" FontSize="11" VerticalAlignment="Center"
                                                                           Visibility="{Binding PlayingNow, Converter={StaticResource BoolVis}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="Add app" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.AddAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SelectedItem, ElementName=AppPicker}" />
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh the list" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.RefreshAppsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding DataContext.NewAppText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Or type an exe name, like Discord.exe" />
                                                <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="Add by name" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.AddAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                        </StackPanel>

                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,6" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeMic}" Margin="0,6">
                                            <StackPanel>
                                                <TextBlock Text="Include my microphone" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Caption what you say too, like both sides of a call" />
                                            </StackPanel>
                                        </CheckBox>
                                        <Grid Margin="0,6" Visibility="{Binding IncludeMic, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Microphone" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding DataContext.InputDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Mic}" DisplayMemberPath="Name" Width="300" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,4">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DialogueFocus}" Margin="0,10">
                                        <StackPanel>
                                            <TextBlock Text="Focus on dialogue" />
                                            <TextBlock Style="{StaticResource Sub}" Text="Pulls voices forward and turns down music and effects (uses the center channel on surround audio). Best for movies and shows." />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <TextBlock Text="Language and translation" Style="{StaticResource SectionLabel}" />
                                <Border Style="{StaticResource Card}" Padding="16,12">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Spoken language" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Detect automatically, or fix it for more accuracy" />
                                            </StackPanel>
                                            <ComboBox ItemsSource="{Binding DataContext.SpokenLanguages, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Language}" Width="240" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" />
                                        <TextBlock Text="Show captions in" Margin="0,12,0,8" />
                                        <Border Style="{StaticResource SegPanel}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SegButton}" Content="The spoken language" Command="{Binding DataContext.SetTranslateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="off"
                                                        Tag="{Binding Translate, Converter={StaticResource Eq}, ConverterParameter=off}" />
                                                <Button Style="{StaticResource SegButton}" Content="English (Whisper)" Command="{Binding DataContext.SetTranslateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="english"
                                                        Tag="{Binding Translate, Converter={StaticResource Eq}, ConverterParameter=english}" />
                                                <Button Style="{StaticResource SegButton}" Content="Another language (Ollama)" Command="{Binding DataContext.SetTranslateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="ollama"
                                                        Tag="{Binding Translate, Converter={StaticResource Eq}, ConverterParameter=ollama}" />
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOriginal}" Margin="0,12,0,4"
                                                  Visibility="{Binding Translate, Converter={StaticResource EqVis}, ConverterParameter=english|ollama}">
                                            <StackPanel>
                                                <TextBlock Text="Also show the original" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Adds the source-language line above each translated one" />
                                            </StackPanel>
                                        </CheckBox>
                                        <Grid Margin="0,12,0,4" Visibility="{Binding Translate, Converter={StaticResource EqVis}, ConverterParameter=ollama}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Translate into" />
                                                <TextBlock Style="{StaticResource Sub}" Text="Each finished line goes through your local Ollama (Settings → Translation)" />
                                            </StackPanel>
                                            <ComboBox ItemsSource="{Binding DataContext.TargetLanguages, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding TargetLanguage, UpdateSourceTrigger=LostFocus}" IsEditable="True" Width="240" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ===================== CAPTION BAR ===================== -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=bar}">
                        <Grid>
                            <TextBlock Text="Caption bar" Style="{StaticResource PageTitle}" />
                            <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding MoveBarCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C2;" FontSize="12" />
                                    <TextBlock Text="Move &amp; resize" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="Style" Style="{StaticResource SectionLabel}" Margin="4,0,0,6" />
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                    <Setter Property="Margin" Value="0,0,10,10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button Command="{Binding ApplyBarPresetCommand}" CommandParameter="movie">
                                <Border Width="140" Height="62" CornerRadius="9" Background="#3B4252" BorderThickness="2"
                                        BorderBrush="{Binding BarPreset, Converter={StaticResource EqBrush}, ConverterParameter=movie}">
                                    <TextBlock Text="Movie" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                            </Button>
                            <Button Command="{Binding ApplyBarPresetCommand}" CommandParameter="classic">
                                <Border Width="140" Height="62" CornerRadius="9" Background="#3B4252" BorderThickness="2"
                                        BorderBrush="{Binding BarPreset, Converter={StaticResource EqBrush}, ConverterParameter=classic}">
                                    <Grid><Border Background="#B8000000" CornerRadius="5" Margin="12,16" /><TextBlock Text="Classic" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                                </Border>
                            </Button>
                            <Button Command="{Binding ApplyBarPresetCommand}" CommandParameter="cinema">
                                <Border Width="140" Height="62" CornerRadius="9" Background="#3B4252" BorderThickness="2"
                                        BorderBrush="{Binding BarPreset, Converter={StaticResource EqBrush}, ConverterParameter=cinema}">
                                    <TextBlock Text="Cinema" Foreground="#FFE45C" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="1" /></TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                            </Button>
                            <Button Command="{Binding ApplyBarPresetCommand}" CommandParameter="minimal">
                                <Border Width="140" Height="62" CornerRadius="9" Background="#3B4252" BorderThickness="2"
                                        BorderBrush="{Binding BarPreset, Converter={StaticResource EqBrush}, ConverterParameter=minimal}">
                                    <TextBlock Text="Minimal" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="1" /></TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                            </Button>
                            <Button Command="{Binding ApplyBarPresetCommand}" CommandParameter="contrast">
                                <Border Width="140" Height="62" CornerRadius="9" Background="#3B4252" BorderThickness="2"
                                        BorderBrush="{Binding BarPreset, Converter={StaticResource EqBrush}, ConverterParameter=contrast}">
                                    <Grid><Border Background="Black" CornerRadius="5" Margin="12,16" /><TextBlock Text="High contrast" Foreground="#FFE45C" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                                </Border>
                            </Button>
                            <Button Command="{Binding ApplyBarPresetCommand}" CommandParameter="theme">
                                <Border Width="140" Height="62" CornerRadius="9" Background="#3B4252" BorderThickness="2"
                                        BorderBrush="{Binding BarPreset, Converter={StaticResource EqBrush}, ConverterParameter=theme}">
                                    <Grid><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Margin="12,16" /><TextBlock Text="Match theme" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                                </Border>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="Layout and position" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Lines" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SegPanel}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegButton}" Content="Subtitles" Command="{Binding SetBarCommand}" CommandParameter="layout=subtitle" Tag="{Binding BarLayout, Converter={StaticResource Eq}, ConverterParameter=subtitle}" />
                                            <Button Style="{StaticResource SegButton}" Content="One line" Command="{Binding SetBarCommand}" CommandParameter="layout=one" Tag="{Binding BarLayout, Converter={StaticResource Eq}, ConverterParameter=one}" />
                                            <Button Style="{StaticResource SegButton}" Content="Two lines" Command="{Binding SetBarCommand}" CommandParameter="layout=two" Tag="{Binding BarLayout, Converter={StaticResource Eq}, ConverterParameter=two}" />
                                            <Button Style="{StaticResource SegButton}" Content="Scrolling box" Command="{Binding SetBarCommand}" CommandParameter="layout=scroll" Tag="{Binding BarLayout, Converter={StaticResource Eq}, ConverterParameter=scroll}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Position" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Snap to a screen's bottom or the window you're using, or place it anywhere" />
                                    </StackPanel>
                                    <Border Style="{StaticResource SegPanel}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegButton}" Content="Bottom of screen" Command="{Binding SetBarCommand}" CommandParameter="position=bottom" Tag="{Binding BarPosition, Converter={StaticResource Eq}, ConverterParameter=bottom}" />
                                            <Button Style="{StaticResource SegButton}" Content="Active window" Command="{Binding SetBarCommand}" CommandParameter="position=window" Tag="{Binding BarPosition, Converter={StaticResource Eq}, ConverterParameter=window}" />
                                            <Button Style="{StaticResource SegButton}" Content="Free" Command="{Binding SetBarCommand}" CommandParameter="position=free" Tag="{Binding BarPosition, Converter={StaticResource Eq}, ConverterParameter=free}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Text alignment" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SegPanel}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegButton}" Content="Center" Command="{Binding SetBarCommand}" CommandParameter="align=center" Tag="{Binding BarAlign, Converter={StaticResource Eq}, ConverterParameter=center}" />
                                            <Button Style="{StaticResource SegButton}" Content="Left" Command="{Binding SetBarCommand}" CommandParameter="align=left" Tag="{Binding BarAlign, Converter={StaticResource Eq}, ConverterParameter=left}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Width" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="300" Maximum="2400" Value="{Binding BarWidth}" SmallChange="10" LargeChange="100" />
                                        <TextBlock Text="{Binding BarWidth, StringFormat={}{0:0} px}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" Visibility="{Binding BarLayout, Converter={StaticResource EqVis}, ConverterParameter=scroll}" />
                                <Grid Style="{StaticResource Row}" Visibility="{Binding BarLayout, Converter={StaticResource EqVis}, ConverterParameter=scroll}">
                                    <TextBlock Text="Box height" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="100" Maximum="1000" Value="{Binding BarBoxHeight}" />
                                        <TextBlock Text="{Binding BarBoxHeight, StringFormat={}{0:0} px}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Distance from the bottom" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="0" Maximum="400" Value="{Binding BarBottomMargin}" />
                                        <TextBlock Text="{Binding BarBottomMargin, StringFormat={}{0:0} px}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Text" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Font" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding BarFont}" Width="260" HorizontalAlignment="Right">
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Size" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="12" Maximum="72" Value="{Binding BarFontSize}" SmallChange="1" LargeChange="4" />
                                        <TextBlock Text="{Binding BarFontSize, StringFormat={}{0:0} pt}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BarBold}" Margin="0,12"><TextBlock Text="Bold" /></CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Outline" />
                                        <TextBlock Style="{StaticResource Sub}" Text="A black edge around letters, like film subtitles (Subtitles layout)" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="0" Maximum="6" Value="{Binding BarOutline}" SmallChange="0.5" LargeChange="1" />
                                        <TextBlock Text="{Binding BarOutline, StringFormat={}{0:0.#} px}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Characters per line" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Subtitles layout. 42 is the broadcast standard" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="28" Maximum="70" Value="{Binding BarMaxChars}" SmallChange="1" LargeChange="4" />
                                        <TextBlock Text="{Binding BarMaxChars}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BarShowTentative}" Margin="0,12">
                                    <StackPanel><TextBlock Text="Show words as soon as they're heard" /><TextBlock Style="{StaticResource Sub}" Text="Fastest. Off: only show words once they've settled (steadier, a little later)" /></StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BarShadow}" Margin="0,12">
                                    <StackPanel><TextBlock Text="Text shadow" /><TextBlock Style="{StaticResource Sub}" Text="Keeps text readable without a background" /></StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BarDimPartial}" Margin="0,12">
                                    <StackPanel><TextBlock Text="Dim words still being heard" /><TextBlock Style="{StaticResource Sub}" Text="The newest words can still change; they settle when the sentence ends" /></StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Text color" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding TextColors}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BaseButton}" Margin="2,0" Command="{Binding DataContext.SetTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Ellipse Width="22" Height="22" Fill="{Binding Converter={StaticResource HexBrush}}" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding BarTextColor, UpdateSourceTrigger=LostFocus}" Width="90" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Background" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding BackgroundColors}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BaseButton}" Margin="2,0" Command="{Binding DataContext.SetBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Ellipse Width="22" Height="22" Fill="{Binding Converter={StaticResource HexBrush}}" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Text="{Binding BarBackground, UpdateSourceTrigger=LostFocus}" Width="90" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Background opacity" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="0" Maximum="1" Value="{Binding BarOpacity}" SmallChange="0.05" LargeChange="0.1" />
                                        <TextBlock Text="{Binding BarOpacity, Converter={StaticResource Pct}}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== MODEL ===================== -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=model}">
                        <TextBlock Text="Speech model" Style="{StaticResource PageTitle}" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Run on" />
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding GpuSummary}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource SegPanel}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegButton}" Content="Automatic" Command="{Binding SetProcessorCommand}" CommandParameter="auto" Tag="{Binding Processor, Converter={StaticResource Eq}, ConverterParameter=auto}" />
                                            <Button Style="{StaticResource SegButton}" Content="GPU" Command="{Binding SetProcessorCommand}" CommandParameter="gpu" Tag="{Binding Processor, Converter={StaticResource Eq}, ConverterParameter=gpu}" />
                                            <Button Style="{StaticResource SegButton}" Content="CPU" Command="{Binding SetProcessorCommand}" CommandParameter="cpu" Tag="{Binding Processor, Converter={StaticResource Eq}, ConverterParameter=cpu}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KeepModelLoaded}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Text="Keep the model loaded when captions are off" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Starts instantly, but keeps using GPU memory. Off: Caption frees all of it." />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Models" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Models}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding SizeText}" Margin="10,0,0,0" Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="In use" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Blurb}" Style="{StaticResource Sub}" Margin="0,3,0,0" />
                                                <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" Foreground="{DynamicResource FaintBrush}">
                                                    <Run Text="Speed " /><Run Text="{Binding Speed, Mode=OneWay, Converter={StaticResource Dots}}" /><Run Text="   Accuracy " /><Run Text="{Binding Accuracy, Mode=OneWay, Converter={StaticResource Dots}}" /><Run Text="   " /><Run Text="{Binding SpeedLabel, Mode=OneWay}" />
                                                </TextBlock>
                                                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}" Margin="0,8,0,0">
                                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" />
                                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Sub}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Sub}" Margin="0,4,0,0"
                                                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button Style="{StaticResource SoftButton}" Content="Download" Command="{Binding DownloadCommand}"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                                                <Button Style="{StaticResource SoftButton}" Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0"
                                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}" />
                                                <Button Style="{StaticResource AccentButton}" Content="Use" Command="{Binding UseCommand}" Padding="14,7">
                                                    <Button.Visibility>
                                                        <MultiBinding Converter="{StaticResource AllVis}">
                                                            <Binding Path="IsInstalled" />
                                                            <Binding Path="IsActive" Converter="{StaticResource Not}" />
                                                        </MultiBinding>
                                                    </Button.Visibility>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete this model" Command="{Binding DeleteCommand}" Margin="6,0,0,0"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ModelsDiskText}" Style="{StaticResource Sub}" Margin="4,2,0,0" />

                        <TextBlock Text="Listening" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Update the line every" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Lower is snappier and uses the GPU more" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="200" Maximum="1500" Value="{Binding UpdateIntervalMs}" SmallChange="50" LargeChange="100" />
                                        <TextBlock Text="{Binding UpdateIntervalText}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="A pause this long ends a line" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Shorter finishes lines sooner; longer keeps sentences together" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="300" Maximum="2000" Value="{Binding PauseToEndMs}" SmallChange="50" LargeChange="100" />
                                        <TextBlock Text="{Binding PauseToEndText}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Longest line" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Long, unbroken speech is split into lines of about this length" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="4" Maximum="20" Value="{Binding MaxLineSeconds}" SmallChange="1" LargeChange="2" />
                                        <TextBlock Text="{Binding MaxLineText}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Voice detection sensitivity" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Higher catches quiet speech; lower ignores more background noise" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Slider Minimum="0.1" Maximum="0.85" Value="{Binding VadSensitivity}" SmallChange="0.05" LargeChange="0.1" />
                                        <TextBlock Text="{Binding VadSensitivity, Converter={StaticResource Pct}}" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FilterHallucinations}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Text="Hide made-up lines" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Drops phrases Whisper tends to invent over music or silence, like &quot;Thanks for watching!&quot;" />
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSoundLabels}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Text="Show sound labels" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Keep things like [Music] or (laughs)" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== TRANSLATION ===================== -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=translation}">
                        <TextBlock Text="Translation" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Two ways to translate" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                                           Text="English (Whisper): the speech model itself translates any language to English, with no extra software. Medium and Large v3 do this well; Large v3 Turbo wasn't trained for it." />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                                           Text="Another language (Ollama): each finished line is sent to the Ollama server on your PC and translated into the language you pick. Nothing leaves your computer." />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Foreground="{DynamicResource FaintBrush}"
                                           Text="Choose which one each profile uses in Audio &amp; profiles." />
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10,7" Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding CurrentModelTranslatesWell, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource WarnBrush}" />
                                        <TextBlock Text="Your current model is Large v3 Turbo: for English translation, use Medium or Large v3, or translate through Ollama." Margin="8,0,0,0" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Ollama" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Address" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Where Ollama is running. Only this PC or your own network are allowed." />
                                    </StackPanel>
                                    <TextBox Text="{Binding OllamaUrl, UpdateSourceTrigger=LostFocus}" Width="260" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Model" />
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding OllamaStatus}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding OllamaModel}" Width="260" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Margin="4,0,0,0" Command="{Binding RefreshOllamaCommand}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Sub}" Margin="4,10,0,0"
                                   Text="Tip: a small instruction model like qwen2.5:7b or gemma3:12b translates captions quickly on your GPU alongside Whisper." />
                    </StackPanel>

                    <!-- ===================== APPEARANCE ===================== -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=appearance}">
                        <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Theme" Style="{StaticResource SectionLabel}" Margin="4,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BaseButton}" Margin="0,0,10,10" Padding="0" ToolTip="{Binding Description}"
                                            Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                                        <StackPanel Width="132">
                                            <Border x:Name="Frame" Height="78" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource BorderStrongBrush}" Background="{Binding Background}">
                                                <Grid Margin="10">
                                                    <Border Background="{Binding Surface}" CornerRadius="6" />
                                                    <StackPanel Margin="9,9,9,0">
                                                        <Border Height="5" Width="58" HorizontalAlignment="Left" CornerRadius="2.5" Background="{Binding Text}" />
                                                        <Border Height="5" Width="40" HorizontalAlignment="Left" CornerRadius="2.5" Background="{Binding Text}" Opacity="0.5" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <Border Height="10" Width="28" CornerRadius="5" Background="{Binding Accent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Margin="2,6,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Accent color" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BaseButton}" Margin="0,0,8,8" Padding="0" ToolTip="{Binding Label}"
                                                    Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Value}">
                                                <Border x:Name="Ring" CornerRadius="17" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                    <Grid>
                                                        <Ellipse Width="26" Height="26" Fill="{Binding Brush}" />
                                                        <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" Margin="10,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="theme">
                                                    <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Ring" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Value}" Value="windows">
                                                    <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Label" Property="Margin" Value="34,0,10,0" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Custom" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                    <Button Style="{StaticResource SoftButton}" Content="Apply" Margin="6,0,0,0" Command="{Binding ApplyCustomAccentCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Theme files" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Sub}" Text="Custom themes are small JSON files in the suite's format (the same as Hangar). Caption reads its own themes folder and Hangar's." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource SoftButton}" Content="Open folder" Command="{Binding OpenThemesFolderCommand}" />
                                    <Button Style="{StaticResource SoftButton}" Content="Reload" Margin="6,0,0,0" Command="{Binding ReloadThemesCommand}" />
                                    <Button Style="{StaticResource SoftButton}" Content="Save as file" Margin="6,0,0,0" Command="{Binding SaveThemeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== HOTKEYS ===================== -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=hotkeys}">
                        <TextBlock Text="Hotkeys" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Show or hide captions" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Turns captions on and off" />
                                    </StackPanel>
                                    <controls:HotkeyRecorder Hotkey="{Binding ToggleHotkey}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Pause or resume" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Stops listening for a moment, keeps the model ready" />
                                    </StackPanel>
                                    <controls:HotkeyRecorder Hotkey="{Binding PauseHotkey}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Move &amp; resize the caption bar" VerticalAlignment="Center" />
                                    <controls:HotkeyRecorder Hotkey="{Binding MoveHotkey}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <TextBlock Text="Open the transcript" VerticalAlignment="Center" />
                                    <controls:HotkeyRecorder Hotkey="{Binding TranscriptHotkey}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Sub}" Margin="4,10,0,0" Text="Click a box, then press the keys. Backspace clears it, Esc cancels. Ctrl + , opens Settings." />
                        <TextBlock Style="{StaticResource Sub}" Margin="4,8,0,0" Text="{Binding HotkeyWarning}" Foreground="{DynamicResource WarnBrush}"
                                   Visibility="{Binding HotkeyWarning, Converter={StaticResource NullVis}}" />
                    </StackPanel>

                    <!-- ===================== GENERAL ===================== -->
                    <StackPanel Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=general}">
                        <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Waits quietly in the tray, using almost nothing until you turn captions on" />
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoSaveTranscripts}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Text="Save transcripts automatically" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Writes a .txt and .srt each time captions are turned off" />
                                    </StackPanel>
                                </CheckBox>
                                <Button Style="{StaticResource LinkButton}" Content="Open the transcripts folder" Command="{Binding OpenTranscriptsFolderCommand}" Margin="0,0,0,12" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Updates" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoUpdate}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Text="Update automatically" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Checks GitHub when Caption starts and every few hours, and downloads new versions in the background" />
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Style="{StaticResource Row}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Channel" />
                                        <TextBlock Style="{StaticResource Sub}" Text="Beta gets new features first" />
                                    </StackPanel>
                                    <Border Style="{StaticResource SegPanel}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegButton}" Content="Stable" Command="{Binding SetChannelCommand}" CommandParameter="stable" Tag="{Binding UpdateChannel, Converter={StaticResource Eq}, ConverterParameter=stable}" />
                                            <Button Style="{StaticResource SegButton}" Content="Beta" Command="{Binding SetChannelCommand}" CommandParameter="beta" Tag="{Binding UpdateChannel, Converter={StaticResource Eq}, ConverterParameter=beta}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Divider}" />
                                <Grid Margin="0,12">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock><Run Text="Caption " /><Run Text="{Binding Updater.CurrentVersion, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding Updater.Status}" Style="{StaticResource Sub}" Margin="0,2,0,0" MaxWidth="420" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Style="{StaticResource SoftButton}" Content="Check for updates now" Command="{Binding CheckUpdatesCommand}"
                                                IsEnabled="{Binding Updater.IsBusy, Converter={StaticResource Not}}"
                                                Visibility="{Binding Updater.UpdateReady, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                                        <Button Style="{StaticResource AccentButton}" Content="Restart to update" Command="{Binding RestartToUpdateCommand}"
                                                Visibility="{Binding Updater.UpdateReady, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,0,0,12" Visibility="{Binding RollbackVersions.Count, Converter={StaticResource EqVis}, ConverterParameter=1|2|3}">
                                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                                    <TextBlock Text="Go back to an earlier version" />
                                    <ItemsControl ItemsSource="{Binding RollbackVersions}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SoftButton}" Margin="0,0,6,0" Content="{Binding}" ContentStringFormat="Roll back to {0}"
                                                        Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="About" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Sub}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           Text="Caption is 100% local: audio and text never leave your PC. Speech recognition is whisper.cpp; nothing runs in the background while captions are off. No accounts, no telemetry." />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"><Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,2,0,0" Text="{Binding PortableText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource SoftButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                                    <Button Style="{StaticResource SoftButton}" Content="Open log" Margin="6,0,0,0" Command="{Binding OpenLogCommand}" />
                                    <Button Style="{StaticResource SoftButton}" Margin="6,0,0,0" Command="{Binding OpenGitHubCommand}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="12" /><TextBlock Text="GitHub" Margin="7,0,0,0" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding QuitCommand}" Foreground="{DynamicResource DangerBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="12" />
                                <TextBlock Text="Quit Caption" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Notice toast -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24" Padding="16,10" CornerRadius="10"
                    Background="{DynamicResource SolidWindowBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    MaxWidth="620" Visibility="{Binding Notice, Converter={StaticResource NullVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26" Margin="10,0,0,0"
                            Command="{Binding DismissNoticeCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
